# Tango32 app patch family (v1.1). Folder name = family id (lowercase letters, digits, "-").
# Type: wrapper library swap — the app's own lib is pointed at our wrapper by renaming one NEEDED entry
#   (same length, so only those bytes change). Nothing from the app is shipped.
# type=symbol: the app breaks on Android functions that are gone. Action's pre-flight check applies it on its own
#   when the app's lib imports one of match_symbol= (space-separated), that symbol is missing on the phone, and the
#   wrapper provides every missing function of that lib (certain match).
# pkgs=: apps known to work with it (comma-separated; applied without any check). lib= may be * (any 32-bit lib
#   that has needed= as NEEDED). rev: bump on every change (phones download only a higher rev).
name=Old Adobe AIR fix
type=symbol
pkgs=air.com.nicotuason.solarmax2
tested=Solarmax 2 1.1.3
fixes=Crash on launch: Adobe AIR (2015) engine libCore.so needs Android media functions removed in Android 9 (MetaData, MediaBuffer, OMXClient, old GraphicBuffer). The wrapper provides them; hardware AAC is turned off, so AIR uses its own audio decoder.
lib=libCore.so
needed=libstagefright.so
wrapper=libstagefrigTG.so
match_symbol=_ZN7android8MetaData7setDataEjjPKvj _ZN7android8MetaDataC1Ev
source=tango_air_shim.c
rev=1
