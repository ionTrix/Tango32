# Tango32 app patch (v1.1)
# One folder per app package. Type: wrapper library swap — the app's own lib is pointed at our wrapper by
#   renaming one NEEDED entry (same length, so only those bytes change). Nothing from the app is shipped.
# rev: bump on every change (phones with online patches download only a higher rev; keep needed/wrapper the same).
name=Galcon Fusion GL fix
tested=1.0.16.1
fixes=Crash on the first frame: the game leaves a GL texture array enabled with a NULL pointer and the 32-bit Adreno driver reads from it. The wrapper skips such arrays per draw.
lib=libmain.so
needed=libGLESv1_CM.so
wrapper=libGLESv1_TG.so
source=tango_gl.c
rev=1
